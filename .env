# Safaricom Daraja API credentials
# Obtain from https://developer.safaricom.co.ke/
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_CALLBACK_URL=https://YOUR-PUBLIC-DOMAIN/api/mpesa/callback

# Server
PORT=3000

# Set true only for local/demo testing; simulates confirmed payment automatically
AUTO_SIMULATE_PAYMENT=true
